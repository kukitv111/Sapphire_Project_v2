map $http_x_correlation_id $sapphire_correlation {
    default $request_id;
    "~^[0-9a-fA-F]{32}$" $http_x_correlation_id;
}

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=connections_per_ip:10m;

log_format sapphire escape=json '{"time":"$time_iso8601","remote":"$remote_addr",'
    '"method":"$request_method","uri":"$uri","status":$status,'
    '"request_time":$request_time,"correlation_id":"$sapphire_correlation"}';

server {
    listen 80;
    server_name ${SAPPHIRE_DOMAIN};
    if ($host != ${SAPPHIRE_DOMAIN}) { return 444; }
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SAPPHIRE_DOMAIN};
    if ($host != ${SAPPHIRE_DOMAIN}) { return 444; }
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Correlation-ID $sapphire_correlation always;
    access_log /var/log/nginx/access.log sapphire;

    client_max_body_size 1m;
    limit_req zone=api_per_ip burst=60 nodelay;
    limit_conn connections_per_ip 30;
    limit_req_status 429;

    location ^~ /internal/ { return 404; }

    location = /health/auth/ready { proxy_pass http://auth-api:8080/health/ready; include /etc/nginx/proxy_params; }
    location = /health/billing/ready { proxy_pass http://billing-api:8080/health/ready; include /etc/nginx/proxy_params; }
    location = /health/session/ready { proxy_pass http://session-api:8080/health/ready; include /etc/nginx/proxy_params; }

    location ^~ /api/auth/ {
        limit_req zone=auth_per_ip burst=10 nodelay;
        proxy_pass http://auth-api:8080;
        include /etc/nginx/proxy_params;
    }
    location ^~ /api/billing/ { proxy_pass http://billing-api:8080; include /etc/nginx/proxy_params; }
    location ^~ /api/sessions { proxy_pass http://session-api:8080; include /etc/nginx/proxy_params; }
    location ^~ /api/ { proxy_pass http://auth-api:8080; include /etc/nginx/proxy_params; }
    location / { return 404; }
}
