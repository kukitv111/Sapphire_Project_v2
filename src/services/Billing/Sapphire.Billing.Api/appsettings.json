{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=sapphire_billing;Username=admin;Password=CHANGE_ME_DB_PASSWORD"
  },
  "Jwt": {
    "SecretKey": "SET-VIA-ENV-VAR-OR-USER-SECRETS-JWT__SECRETKEY",
    "Issuer": "sapphire-auth",
    "Audience": "sapphire-clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30,
    "UseRsa": false
  }
}
