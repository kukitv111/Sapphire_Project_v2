# Base URLs of backend services (no trailing slash, no /api suffix).
# Defaults (see src/api/config.ts) match backend launchSettings.json:
#   Auth    -> http://localhost:5166
#   Billing -> http://localhost:5191
#   Session -> http://localhost:5268
VITE_AUTH_API_URL=http://localhost:5166
VITE_BILLING_API_URL=http://localhost:5191
VITE_SESSION_API_URL=http://localhost:5268
# Optional single entry point; reserved for the API gateway (not implemented yet).
# VITE_GATEWAY_URL=http://localhost:8080
